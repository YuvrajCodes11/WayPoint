# WayPoint Web & Supabase Configuration Template
# DO NOT place actual secrets in this file. Copy to .env.local for development.

# Public Supabase Client Credentials (Safe to expose to client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key-here

# Server-Side Only Service Role Key (NEVER expose to browser/client bundle)
SUPABASE_SERVICE_ROLE_KEY=your-server-side-service-role-key-do-not-expose-to-client
